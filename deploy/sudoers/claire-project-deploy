# Permite ao usuário jarvis reiniciar SÓ o serviço claire-project sem senha,
# pra o cron do auto-deploy.sh (rodando como jarvis) poder chamar systemctl restart.
# Instalar com: sudo cp deploy/sudoers/claire-project-deploy /etc/sudoers.d/
#               sudo chmod 440 /etc/sudoers.d/claire-project-deploy
#               sudo visudo -c
jarvis ALL=(root) NOPASSWD: /usr/bin/systemctl restart claire-project
